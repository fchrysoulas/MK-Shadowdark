<form class="mk-group-sheet {{cssClass}}" autocomplete="off" style="{{mk.sheetStyle}}">
  <header class="mk-group-header">
    <img class="mk-group-image" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}">

    <div class="mk-group-title-block">
      <input class="mk-group-name" name="name" type="text" value="{{actor.name}}" placeholder="Group Name">

      <div class="mk-group-stats">
        <span><i class="fas fa-users"></i> Members <strong>{{mk.summary.count}}</strong></span>
        <span><i class="fas fa-heart"></i> HP <strong>{{mk.summary.hp.value}}/{{mk.summary.hp.max}}</strong></span>
        <span><i class="fas fa-shield-alt"></i> Avg AC <strong>{{mk.summary.ac}}</strong></span>
        <span><i class="fas fa-arrow-up"></i> Avg LVL <strong>{{mk.summary.level}}</strong></span>
      </div>
    </div>
  </header>

  <section class="mk-active-torches" aria-label="Active torches">
    <header class="mk-active-torches-header">
      <span><i class="fas fa-fire"></i> Active Torches</span>
      <strong>{{mk.activeTorches.count}}</strong>
    </header>
    {{#if mk.activeTorches.hasEntries}}
    <div class="mk-active-torches-list">
      {{#each mk.activeTorches.entries}}
      <article class="mk-active-torch" data-active-torch-id="{{id}}">
        <img src="{{img}}" alt="{{name}}">
        <div class="mk-active-torch-details">
          <strong>{{name}}</strong>
          <span>{{ownerName}}</span>
        </div>
        <div class="mk-active-torch-bar" title="Approximate remaining burn time" aria-label="Approximate remaining burn time">
          {{#each segments}}<i class="{{#if lit}}is-lit{{/if}}"></i>{{/each}}
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    <p class="mk-active-torches-empty">No torches are currently lit.</p>
    {{/if}}
  </section>

  <nav class="mk-group-nav tabs" data-group="primary">
    <a class="item active" data-tab="summary" data-tooltip="Summary" aria-label="Summary" tabindex="0"><i class="fas fa-clipboard-list" aria-hidden="true"></i></a>
    <a class="item" data-tab="traveling" data-tooltip="Traveling" aria-label="Traveling" tabindex="0"><i class="fas fa-route" aria-hidden="true"></i></a>
    <a class="item" data-tab="camping" data-tooltip="Camping" aria-label="Camping" tabindex="0"><i class="fas fa-campground" aria-hidden="true"></i></a>
    <a class="item" data-tab="inventory" data-tooltip="Inventory" aria-label="Inventory" tabindex="0"><i class="fas fa-box-open" aria-hidden="true"></i></a>
    <a class="item" data-tab="hirelings" data-tooltip="Hirelings" aria-label="Hirelings" tabindex="0"><i class="fas fa-user-shield" aria-hidden="true"></i></a>
    <a class="item" data-tab="warbands" data-group-actor-kind="warbands" data-tooltip="Warbands" aria-label="Warbands" tabindex="0"><i class="fas fa-people-group" aria-hidden="true"></i></a>
    <a class="item" data-tab="mounts" data-tooltip="Mounts" aria-label="Mounts" tabindex="0"><i class="fas fa-horse" aria-hidden="true"></i></a>
    <a class="item" data-tab="boats" data-group-actor-kind="boats" data-tooltip="Boats" aria-label="Boats" tabindex="0"><i class="fas fa-ship" aria-hidden="true"></i></a>
    <a class="item" data-tab="bastions" data-group-actor-kind="bastions" data-tooltip="Bastion" aria-label="Bastion" tabindex="0"><i class="fas fa-chess-rook" aria-hidden="true"></i></a>
  </nav>

  <div class="mk-group-member-source" aria-hidden="true">
    {{#each mk.members}}
    <article
      class="mk-group-member"
      data-member-uuid="{{uuid}}"
      data-party-active="{{#if isActivePartyMember}}true{{else}}false{{/if}}"
      data-travel-assignment="{{travelAssignment}}"
      data-camping-assignment="{{campingAssignment}}"
    >
      <img class="mk-member-image" src="{{img}}" alt="{{name}}" data-action="open-member">

      <div class="mk-member-main">
        <div class="mk-member-name-row">
          <button type="button" class="mk-member-name" data-action="open-member">{{name}}</button>
          <span class="mk-member-class">{{className}}</span>
        </div>

        <div class="mk-member-hp-row">
          <span class="mk-hp-text">{{hp.value}}/{{hp.max}}</span>
          <div class="mk-hp-bar"><div class="mk-hp-fill" style="width: {{hp.pct}}%;"></div></div>
        </div>

        <div class="mk-member-abilities">
          {{#each abilities}}
          <button type="button" class="mk-ability-button" data-action="roll-ability" data-ability="{{key}}" title="Roll {{label}}">
            <span>{{label}}</span>
            <strong>{{mod}}</strong>
          </button>
          {{/each}}
        </div>
      </div>

      <div class="mk-member-side-stats">
        <span class="mk-side-stat">AC <strong>{{ac}}</strong></span>
        <span class="mk-side-stat">LVL <strong>{{level}}</strong></span>
        <span class="mk-side-stat">XP <strong>{{xp.value}}/{{xp.next}}</strong></span>
        <span class="mk-side-stat {{#if slots.over}}mk-danger{{/if}}">Slots <strong>{{slots.total}}/{{slots.max}}</strong></span>
      </div>
    </article>
    {{/each}}
  </div>

  <section class="mk-group-content">
    <div class="tab mk-group-tab mk-group-tab-body active" data-group="primary" data-tab="summary">
      <section class="mk-companions-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Summary</h2>
            <p>Group assets and weekly payroll.</p>
          </div>
        </header>
        <div class="mk-group-summary-resources">
          <div><span>Party Treasure</span><strong>{{mk.inventory.coins.gp}} GP · {{mk.inventory.coins.sp}} SP · {{mk.inventory.coins.cp}} CP</strong></div>
          <div><span>Hireling Salaries</span><strong>{{mk.assets.wages.hirelings}} gp/week</strong></div>
          <div>
            <span>Warband Wages{{#if mk.assets.wages.incomplete}} (Subtotal){{/if}}</span>
            <strong>{{mk.assets.wages.warbands}} gp/week</strong>
            {{#if mk.assets.wages.incomplete}}<small>Some warband wages are unavailable.</small>{{/if}}
          </div>
          <div><span>{{#if mk.assets.wages.incomplete}}Known Wages &amp; Salaries{{else}}Total Wages &amp; Salaries{{/if}}</span><strong>{{mk.assets.wages.total}} gp/week</strong></div>
        </div>
        <div class="mk-group-summary-grid">
          {{#each mk.assets.categories}}
          <section class="mk-group-summary-category">
            <header>
              <h3><i class="fas {{icon}}" aria-hidden="true"></i> {{label}}</h3>
              <strong class="mk-group-summary-count">{{count}}</strong>
            </header>
            {{#if count}}
            <ul class="mk-group-summary-list">
              {{#each entries}}
              <li>
                {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fas {{../icon}}" aria-hidden="true"></i>{{/if}}
                <div>
                  <strong>{{name}}</strong>
                  {{#if detail}}<span>{{detail}}</span>{{/if}}
                  {{#each assignments}}<span>{{label}}: {{text}}</span>{{/each}}
                </div>
              </li>
              {{/each}}
            </ul>
            {{else}}
            <p class="mk-group-summary-empty">None assigned.</p>
            {{/if}}
          </section>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="traveling">
      <section class="mk-companions-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Traveling</h2>
            <p>Assign party members to travel tasks and track the journey.</p>
          </div>
        </header>
        <div class="mk-travel-toolbar">
          <button type="button" data-action="cycle-weather" title="{{mk.travel.weatherTooltip}}">
            <i class="fas fa-cloud-sun-rain"></i> Weather:
            {{#if mk.travel.weatherSummaries.hasResults}}
              {{#if mk.travel.weatherSummaries.temperature}}Temperature: <span class="mk-weather-keyword">{{mk.travel.weatherSummaries.temperature}}</span>{{/if}}
              {{#if mk.travel.weatherSummaries.temperature}}{{#if mk.travel.weatherSummaries.windSpeed}}&middot;{{/if}}{{/if}}
              {{#if mk.travel.weatherSummaries.windSpeed}}Wind Speed: <span class="mk-weather-keyword">{{mk.travel.weatherSummaries.windSpeed}}</span>{{/if}}
            {{else}}
              {{mk.travel.weatherLabel}}
            {{/if}}
          </button>

          <label class="mk-speed-control">Speed
            <select data-action="change-speed">
              {{#each mk.travel.speedOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>

          <label class="mk-travel-number-control">MPH
            <input type="number" data-action="change-miles-per-hour" value="{{mk.travel.milesPerHour}}" min="0" max="100" step="0.1">
          </label>

          <label class="mk-travel-number-control">Hexes
            <input type="number" data-action="change-hexes-to-explore" value="{{mk.travel.hexesToExplore}}" min="0" max="999" step="1">
          </label>

          {{#if mk.canEditGroup}}
          <button type="button" data-action="start-travel-rolls" {{#unless mk.travel.hasAssigned}}disabled{{/unless}}>
            <i class="fas fa-bullhorn"></i> Prompt Travelling
          </button>
          {{/if}}
        </div>

        <div class="mk-travel-progress" data-prompt-id="{{mk.travel.progress.promptId}}" data-travel-duration-ms="{{mk.travel.progress.durationMs}}" style="--mk-travel-progress-fill: {{mk.travel.progress.percent}}%;">
          <span class="mk-travel-progress-track" aria-hidden="true">
            <span class="mk-travel-progress-fill" data-travel-progress-fill></span>
          </span>
          {{#each mk.travel.progress.steps}}
          <div class="mk-travel-progress-step {{#if complete}}is-complete{{/if}} {{#if failed}}is-failed{{/if}} {{#if successOutcome}}is-success-result{{/if}} {{#if failureOutcome}}is-failure-result{{/if}} {{#if active}}is-active{{/if}} {{#if pending}}is-pending{{/if}} {{#if empty}}is-empty{{/if}}" data-travel-progress-step="{{key}}">
            <span class="mk-travel-progress-node">
              <img src="{{icon}}" alt="">
            </span>
            <span class="mk-travel-progress-label">{{name}}</span>
            <span class="mk-travel-progress-count">
              <span data-progress-completed>{{completedCount}}</span>/<span data-progress-assigned>{{assignedCount}}</span>
            </span>
            <span class="mk-travel-progress-status" data-progress-status>{{statusLabel}}</span>
            <span class="mk-travel-progress-results" data-progress-results>
              {{#each resultMarks}}
              <span data-travel-result="{{type}}" title="{{label}}">{{symbol}}</span>
              {{/each}}
            </span>
          </div>
          {{/each}}
        </div>

        {{#if mk.travel.hasMembers}}
        <div class="mk-camping-roster mk-travel-roster">
          {{#each mk.travel.members}}
          <button
            type="button"
            class="mk-camping-roster-member {{#if assigned}}is-assigned{{/if}} {{#unless canAssign}}is-unavailable{{/unless}}"
            data-action="open-member"
            data-camping-member-drag="true"
            data-activity-kind="travel"
            data-member-uuid="{{uuid}}"
            data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
            draggable="{{#if canAssign}}true{{else}}false{{/if}}"
            title="{{#unless canAssign}}{{name}} is controlled by another user{{else}}{{#if assignedActivityName}}{{name}}: {{assignedActivityName}}{{else}}{{name}} is unassigned{{/if}}{{/unless}}"
          >
            <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
            <span>{{name}}</span>
            {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{else}}<small>Free</small>{{/if}}
          </button>
          {{/each}}
          {{#if mk.canEditGroup}}
          <button type="button" class="mk-camping-reset" data-action="reset-travel" data-activity-kind="travel" data-tooltip="Reset Travel Assignments" aria-label="Reset Travel Assignments">
            <i class="fas fa-undo"></i>
          </button>
          {{/if}}
        </div>
        {{else}}
        <div class="mk-camping-roster-empty">Add members to the group to assign travel tasks.</div>
        {{/if}}

        <div class="mk-travel-grid">
          {{#each mk.travel.activities}}
          <article class="mk-travel-card" data-activity-kind="travel" data-travel-activity-key="{{key}}">
            <header class="mk-travel-card-header">
              <span class="mk-travel-activity-icon" aria-hidden="true">
                <img src="{{icon}}" alt="">
              </span>

              <div class="mk-travel-title" data-tooltip="{{description}}" aria-label="{{description}}" tabindex="0">
                <strong class="mk-travel-name">{{name}}</strong>
                <span class="mk-travel-meta">{{abilityLabel}} <b>DC {{dc}}</b></span>
              </div>

              <button type="button" class="mk-travel-roll" data-action="roll-travel-activity" data-has-assigned="{{#if hasAssigned}}true{{else}}false{{/if}}" title="{{#if hasAssigned}}Roll {{name}}{{else}}Assign a character to roll {{name}}{{/if}}" {{#unless hasAssigned}}disabled{{/unless}}>
                <i class="fas fa-dice-d20"></i>
              </button>
            </header>

            <div class="mk-camping-assignment-row" data-action="toggle-travel-picker" title="Choose assigned members">
              <div class="mk-camping-assignment-summary" title="{{assignmentLabel}}">
                {{#if hasAssigned}}
                {{#each assigned}}
                <button type="button" class="mk-camping-assigned-chip" data-action="open-member" data-assigned-actor-uuid="{{uuid}}" title="{{name}}">
                  <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
                </button>
                {{/each}}
                {{else}}
                <span class="mk-camping-unassigned">Unassigned</span>
                {{/if}}
              </div>
            </div>

            {{#if hasMemberOptions}}
            <div class="mk-camping-picker-panel">
              <div class="mk-travel-member-picker">
                {{#each memberOptions}}
                <button
                  type="button"
                  class="mk-travel-member-toggle {{#if assigned}}is-assigned{{/if}} {{#if assignedElsewhere}}is-assigned-elsewhere{{/if}}"
                  data-action="toggle-travel-participant"
                  data-member-uuid="{{uuid}}"
                  data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
                  title="{{title}}"
                  {{#unless canAssign}}disabled{{/unless}}
                >
                  <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
                  <span>{{name}}</span>
                  {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{/if}}
                </button>
                {{/each}}
              </div>
            </div>
            {{/if}}
          </article>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="camping">
      <section class="mk-companions-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Camping</h2>
            <p>Assign camp tasks and manage the party's rest.</p>
          </div>
        </header>
        <section class="mk-camping-info">
          <div class="mk-campfire-note">
            <strong>Campfire</strong>
            <p>The PCs can make a campfire using 3 torches; it lasts 8 hours while a PC remains near to it and casts light out to a near distance.</p>
            <div class="mk-campfire-resources">
              <span title="Total food and rations carried by members plus shared group inventory">
                <i class="fas fa-utensils"></i>
                <strong>{{mk.campingResources.food.total}}</strong>
              </span>
              <span title="Total torches carried by members plus shared group inventory">
                <i class="fas fa-fire"></i>
                <strong>{{mk.campingResources.torches.total}}</strong>
              </span>
              {{#if mk.canEditGroup}}
              <button type="button" class="mk-group-rest-button" data-action="rest-party">
                <i class="fas fa-bed"></i> Rest Party
              </button>
              {{/if}}
            </div>
          </div>
        </section>

        {{#if mk.camping.hasMembers}}
        <div class="mk-camping-roster">
          {{#each mk.camping.members}}
          <button
            type="button"
            class="mk-camping-roster-member {{#if assigned}}is-assigned{{/if}} {{#unless canAssign}}is-unavailable{{/unless}}"
            data-action="open-member"
            data-camping-member-drag="true"
            data-activity-kind="camping"
            data-member-uuid="{{uuid}}"
            data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
            draggable="{{#if canAssign}}true{{else}}false{{/if}}"
            title="{{#unless canAssign}}{{name}} is controlled by another user{{else}}{{#if assignedActivityName}}{{name}}: {{assignedActivityName}}{{else}}{{name}} is unassigned{{/if}}{{/unless}}"
          >
            <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
            <span>{{name}}</span>
            {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{else}}<small>Free</small>{{/if}}
          </button>
          {{/each}}
          {{#if mk.canEditGroup}}
          <button type="button" class="mk-camping-reset" data-action="reset-travel" data-activity-kind="camping" data-tooltip="Reset Camping Assignments" aria-label="Reset Camping Assignments">
            <i class="fas fa-undo"></i>
          </button>
          {{/if}}
        </div>
        {{else}}
        <div class="mk-camping-roster-empty">Add members to the group to assign camping tasks.</div>
        {{/if}}

        <div class="mk-travel-grid">
          {{#each mk.camping.activities}}
          <article class="mk-travel-card" data-activity-kind="camping" data-travel-activity-key="{{key}}">
            <header class="mk-travel-card-header">
              <span class="mk-travel-activity-icon" aria-hidden="true">
                <img src="{{icon}}" alt="">
              </span>

              <div class="mk-travel-title" data-tooltip="{{description}}" aria-label="{{description}}" tabindex="0">
                <strong class="mk-travel-name">{{name}}</strong>
                <span class="mk-travel-meta">{{abilityLabel}} <b>DC {{dc}}</b></span>
              </div>

              <button type="button" class="mk-travel-roll" data-action="roll-travel-activity" data-has-assigned="{{#if hasAssigned}}true{{else}}false{{/if}}" title="{{#if hasAssigned}}Roll {{name}}{{else}}Assign a character to roll {{name}}{{/if}}" {{#unless hasAssigned}}disabled{{/unless}}>
                <i class="fas fa-dice-d20"></i>
              </button>
            </header>

            <div class="mk-camping-assignment-row" data-action="toggle-travel-picker" title="Choose assigned members">
              <div class="mk-camping-assignment-summary" title="{{assignmentLabel}}">
                {{#if hasAssigned}}
                {{#each assigned}}
                <button type="button" class="mk-camping-assigned-chip" data-action="open-member" data-assigned-actor-uuid="{{uuid}}" title="{{name}}">
                  <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
                </button>
                {{/each}}
                {{else}}
                <span class="mk-camping-unassigned">Unassigned</span>
                {{/if}}
              </div>
            </div>

            {{#if hasMemberOptions}}
            <div class="mk-camping-picker-panel">
              <div class="mk-travel-member-picker">
                {{#each memberOptions}}
                <button
                  type="button"
                  class="mk-travel-member-toggle {{#if assigned}}is-assigned{{/if}} {{#if assignedElsewhere}}is-assigned-elsewhere{{/if}}"
                  data-action="toggle-travel-participant"
                  data-member-uuid="{{uuid}}"
                  data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
                  title="{{title}}"
                  {{#unless canAssign}}disabled{{/unless}}
                >
                  <span class="mk-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
                  <span>{{name}}</span>
                  {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{/if}}
                </button>
                {{/each}}
              </div>
            </div>
            {{/if}}
          </article>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="inventory">
      <section class="mk-companions-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Inventory</h2>
            <p>Manage the group's shared gear and party treasure.</p>
          </div>
        </header>
        <div class="mk-inventory-layout">
          <section class="mk-shared-items-panel">
            <header class="mk-inventory-panel-header">
              <button type="button" class="mk-panel-add-button" data-action="create-group-item" title="Add gear"><i class="fas fa-plus"></i></button>
              <h2>Shared Items</h2>
              <span class="mk-inventory-slots {{#if mk.inventory.slots.over}}mk-danger{{/if}}"><i class="fas fa-weight-hanging"></i> <strong>{{mk.inventory.slots.total}}/{{mk.inventory.slots.max}}</strong></span>
            </header>

            <div class="mk-shared-items-table">
              <div class="mk-shared-items-table-header">
                <span>Item</span>
                <span>Qty</span>
                <span>Slots</span>
              </div>

              <div class="mk-shared-items-table-body">
                {{#if mk.inventory.hasItems}}
                {{#each mk.inventory.items}}
                <div class="mk-shared-item-row" data-item-id="{{id}}">
                  <div class="mk-shared-item-name-cell">
                    <img src="{{img}}" alt="{{name}}" data-action="open-item" draggable="false">
                    <button type="button" class="mk-inventory-name" data-action="open-item">{{name}}</button>
                  </div>

                  <div class="mk-shared-item-qty-cell">
                    <button type="button" data-action="item-decrement" title="Decrease quantity"><i class="fas fa-minus"></i></button>
                    <strong>{{quantity}}</strong>
                    <button type="button" data-action="item-increment" title="Increase quantity"><i class="fas fa-plus"></i></button>
                  </div>

                  <div class="mk-shared-item-slots-cell">{{slots}}</div>
                </div>
                {{/each}}
                {{else}}
                <div class="mk-shared-items-empty">No shared items. Drop gear here or press +.</div>
                {{/if}}
              </div>
            </div>
          </section>

          <aside class="mk-party-treasure-panel">
            <h2>Party Treasure</h2>

            <label class="mk-coin-row"><span>GP</span><input type="number" value="{{mk.inventory.coins.gp}}" min="0" data-action="change-group-coin" data-coin="gp"></label>
            <label class="mk-coin-row"><span>SP</span><input type="number" value="{{mk.inventory.coins.sp}}" min="0" data-action="change-group-coin" data-coin="sp"></label>
            <label class="mk-coin-row"><span>CP</span><input type="number" value="{{mk.inventory.coins.cp}}" min="0" data-action="change-group-coin" data-coin="cp"></label>

            <p class="mk-coin-slots"><i class="fas fa-weight-hanging"></i> Coin slots <strong>{{mk.inventory.coinSlots}}</strong></p>

            <button type="button" class="mk-divide-coins-button" data-action="divide-coins"><i class="fas fa-coins"></i> Divide Coins</button>
          </aside>
        </div>
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="hirelings">
      <section class="mk-companions-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Hirelings</h2>
            <p>Hireling carry slots contribute directly to the shared inventory limit.</p>
          </div>
          <strong class="mk-companion-capacity"><i class="fas fa-weight-hanging"></i> {{mk.hirelings.totalCarrySlots}} slots</strong>
        </header>

        {{#if mk.hirelings.hasEntries}}
        <div class="mk-companions-list">
          {{#each mk.hirelings.entries}}
          <article class="mk-companion-row" data-companion-id="{{id}}">
            <i class="fas fa-user-shield mk-companion-icon" aria-hidden="true"></i>
            <div class="mk-companion-fields">
              <label>
                <span>Name</span>
                <input type="text" value="{{name}}" data-action="change-companion" data-companion-field="name" {{#unless ../mk.canEditGroup}}disabled{{/unless}}>
              </label>
              <label>
                <span>Background / Profession</span>
                <input type="text" value="{{background}}" data-action="change-companion" data-companion-field="background" {{#unless ../mk.canEditGroup}}disabled{{/unless}}>
              </label>
              <label>
                <span>Owner</span>
                <select data-action="change-companion" data-companion-field="ownerUuid" {{#unless ../mk.canEditGroup}}disabled{{/unless}}>
                  {{#each ownerOptions}}
                  <option value="{{uuid}}" {{#if selected}}selected{{/if}} {{#if unavailable}}disabled{{/if}}>{{name}}</option>
                  {{/each}}
                </select>
              </label>
              <label>
                <span>Carry slots</span>
                <input type="number" value="{{carrySlots}}" min="0" step="1" data-action="change-companion" data-companion-field="carrySlots" {{#unless ../mk.canEditGroup}}disabled{{/unless}}>
              </label>
            </div>
            {{#if ../mk.canEditGroup}}
            <button type="button" class="mk-companion-remove" data-action="remove-companion" title="Remove {{name}}" aria-label="Remove {{name}}"><i class="fas fa-trash"></i></button>
            {{/if}}
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="mk-companions-empty">No hirelings yet. Add one to contribute carrying capacity to the group.</p>
        {{/if}}

        {{#if mk.canEditGroup}}
        <footer class="mk-companions-actions">
          <button type="button" data-action="add-companion" data-companion-type="hireling"><i class="fas fa-user-plus"></i> Add Hireling</button>
        </footer>
        {{/if}}
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="warbands" data-group-actor-kind="warbands">
      <section class="mk-group-linked-panel">
        <header class="mk-companions-header">
          <div>
            <h2>Warbands</h2>
            <p>Track warbands following the group or assigned to boats and bastions.</p>
          </div>
          <strong class="mk-companion-capacity"><i class="fas fa-people-group" aria-hidden="true"></i> {{mk.warbands.count}}</strong>
        </header>
        <div class="mk-warband-status-summary" aria-label="Warband assignments">
          <span><i class="fas fa-person-walking" aria-hidden="true"></i> Following <strong>{{mk.warbands.counts.following}}</strong></span>
          <span><i class="fas fa-ship" aria-hidden="true"></i> Boats <strong>{{mk.warbands.counts.boat}}</strong></span>
          <span><i class="fas fa-chess-rook" aria-hidden="true"></i> Bastions <strong>{{mk.warbands.counts.bastion}}</strong></span>
        </div>
        {{#if mk.warbands.hasUnavailableBastions}}<p class="mk-warband-assignment-warning">Some linked bastions are unavailable. Warbands without a known assignment are marked as unavailable.</p>{{/if}}
        <div class="mk-group-actor-dropzone">
          <i class="fas fa-people-group" aria-hidden="true"></i>
          <span>Drop an NPC warband anywhere in this tab</span>
          <small>Click a warband to open its sheet. Assign it in the Boats tab or a bastion's Defenses tab.</small>
        </div>
        {{#if mk.warbands.hasEntries}}
        <div class="mk-group-actor-list mk-warband-grid">
          {{#each mk.warbands.entries}}
          <article class="mk-group-actor-card mk-warband-card" data-group-actor-uuid="{{uuid}}">
            <div class="mk-warband-card-header">
              <button type="button" class="mk-group-actor-open" data-action="open-group-actor" data-actor-available="{{available}}" {{#unless available}}disabled{{/unless}}>
                <img src="{{img}}" alt="{{name}}">
                <strong>{{name}}</strong>
              </button>
              {{#if ../mk.canEditGroup}}<button type="button" class="mk-companion-remove" data-action="remove-group-actor" title="Remove {{name}} from group" aria-label="Remove {{name}} from group"><i class="fas fa-trash"></i></button>{{/if}}
            </div>
            <div class="mk-warband-stats">
              <span>Level <strong>{{levelLabel}}</strong></span>
              <span>AC <strong>{{acLabel}}</strong></span>
              <span>HP <strong>{{#if hp.known}}{{hp.value}} / {{hp.max}}{{else}}—{{/if}}</strong></span>
            </div>
            {{#if hp.known}}<div class="mk-warband-hp-track" aria-label="HP {{hp.value}} of {{hp.max}}"><span style="width: {{hp.percent}}%;"></span></div>{{/if}}
            <div class="mk-warband-deployments">
              {{#each deployments}}<span class="mk-warband-deployment is-{{kind}}"><i class="fas {{icon}}" aria-hidden="true"></i> {{label}}</span>{{/each}}
            </div>
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="mk-companions-empty">No warbands yet. Drop an NPC warband into this tab to link it to the group.</p>
        {{/if}}
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="mounts">
      <section class="mk-mounts-panel" data-mount-dropzone="true">
        <header class="mk-companions-header">
          <div>
            <h2>Mounts</h2>
          </div>
          <strong class="mk-companion-capacity"><i class="fas fa-weight-hanging"></i> {{mk.mounts.totalCarrySlots}} free slots</strong>
        </header>

        <div class="mk-mount-rules">
          <span><i class="fas fa-shield-halved"></i> Acts on the rider's initiative; the rider chooses the mount's action.</span>
          <span><i class="fas fa-person-walking-arrow-right"></i> Mounting or dismounting uses the rider's entire movement.</span>
          <span><i class="fas fa-weight-hanging"></i> Gear slots equal 5 x the mount's STR bonus. A rider and their carried gear use 10 slots.</span>
          <span><i class="fas fa-drumstick-bite"></i> Needs 1 ration each day in an unfamiliar environment.</span>
        </div>

        <div class="mk-mount-dropzone" data-mount-dropzone="true">
          <i class="fas fa-horse" aria-hidden="true"></i>
          <span>Drop an NPC mount here</span>
          <small>Then drag an active party member onto the mount to assign its rider.</small>
        </div>

        {{#if mk.mounts.hasEntries}}
        <div class="mk-mounts-list">
          {{#each mk.mounts.entries}}
          <article class="mk-mount-card" data-companion-id="{{id}}" data-mount-rider-dropzone="true">
            {{#if ../mk.canEditGroup}}<button type="button" class="mk-companion-remove mk-mount-remove" data-action="remove-companion" title="Remove {{name}}" aria-label="Remove {{name}}"><i class="fas fa-trash"></i></button>{{/if}}
            <div class="mk-mount-overview">
              <div class="mk-mount-identity">
              <img class="mk-mount-icon" src="{{img}}" alt="{{name}}">
                <strong>{{name}}</strong>
              </div>
              <div class="mk-mount-rider-drop">
                {{#if hasRider}}
                <img class="mk-mount-rider-icon" src="{{riderImg}}" alt="{{riderName}}">
                <strong>{{riderName}}</strong>
                {{#if ../mk.canEditGroup}}<button type="button" data-action="clear-mount-rider" title="Remove rider" aria-label="Remove rider"><i class="fas fa-xmark"></i></button>{{/if}}
                {{else}}
                <i class="fas fa-user mk-mount-rider-placeholder" aria-hidden="true"></i>
                <em>Drop an active party member here</em>
                {{/if}}
              </div>
              <div class="mk-mount-gear-summary">
                <i class="fas fa-suitcase-rolling" aria-hidden="true"></i>
                <strong>{{availableCarrySlots}}</strong>
                <span>Free gear slots</span>
              </div>
              <div class="mk-mount-hp-summary" title="{{hpValue}} / {{hpMax}} HP">
                <div><span>HP</span><strong>{{hpValue}} / {{hpMax}}</strong></div>
                <span class="mk-mount-hp-track"><span class="mk-mount-hp-fill" style="width: {{hpPct}}%;"></span></span>
              </div>
            </div>
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="mk-companions-empty">No mounts yet. Drop a mount actor in the area above.</p>
        {{/if}}
      </section>
    </div>
    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="boats" data-group-actor-kind="boats">
      <section class="mk-group-linked-panel">
        <header class="mk-companions-header"><h2>Boats</h2></header>
        <div class="mk-group-actor-dropzone">
          <i class="fas fa-ship" aria-hidden="true"></i>
          <span>Drop an NPC boat here or in an empty part of this tab</span>
          <small>Click a boat to open its actor sheet. Assign NPCs in its Crew and Warbands areas below.</small>
        </div>
        {{#if mk.boats.hasEntries}}
        <div class="mk-group-actor-list">
          {{#each mk.boats.entries}}
          <article class="mk-group-actor-card mk-boat-card" data-group-actor-uuid="{{uuid}}">
            <header class="mk-boat-header">
              <button type="button" class="mk-group-actor-open" data-action="open-group-actor" data-actor-available="{{available}}" {{#unless available}}disabled{{/unless}}>
                <img src="{{img}}" alt="{{name}}">
                <strong>{{name}}</strong>
              </button>
              {{#if ../mk.canEditGroup}}<button type="button" class="mk-companion-remove" data-action="remove-group-actor" title="Remove {{name}} from group" aria-label="Remove {{name}} from group"><i class="fas fa-trash"></i></button>{{/if}}
            </header>
            <div class="mk-boat-details">
              <label class="mk-boat-captain">
                <span>Captain</span>
                <input type="text" value="{{captainName}}" placeholder="Captain's name" data-action="change-boat" data-boat-field="captainName" {{#unless ../mk.canEditGroup}}disabled{{/unless}}>
              </label>
              <div class="mk-boat-capacity {{#if overCapacity}}is-over-capacity{{/if}}" aria-live="polite">
                <span>Crew slots used</span>
                {{#if available}}
                <strong>{{crewSlotsUsed}} / {{crewSlotCapacity}}</strong>
                <small>{{#if overCapacity}}{{crewSlotsOver}} over capacity{{else}}{{crewSlotsRemaining}} free{{/if}} · Capacity equals maximum ship HP</small>
                {{else}}
                <strong>{{crewSlotsUsed}}</strong>
                <small>Capacity unavailable</small>
                {{/if}}
              </div>
            </div>
            <div class="mk-boat-assignments">
              {{#each assignmentSections}}
              <section class="mk-boat-assignment-section" data-boat-assignment-kind="{{kind}}" aria-label="{{label}} assignments">
                <header><strong>{{label}}</strong><small>{{slotRule}}</small></header>
                <p class="mk-boat-assignment-hint">Drop an NPC here to assign {{label}}.</p>
                {{#if hasEntries}}
                <div class="mk-boat-assignment-list">
                  {{#each entries}}
                  <div class="mk-boat-assignment-row" data-boat-assignment-uuid="{{uuid}}">
                    <button type="button" class="mk-boat-assignment-open" data-action="open-boat-assignment" data-actor-available="{{available}}" {{#unless available}}disabled{{/unless}}>
                      <img src="{{img}}" alt="{{name}}"><strong>{{name}}</strong>
                    </button>
                    <label class="mk-boat-assignment-quantity">
                      <span>Qty</span>
                      <input type="number" value="{{quantity}}" min="1" step="1" data-action="change-boat" data-boat-field="quantity" {{#unless ../../../mk.canEditGroup}}disabled{{/unless}}>
                    </label>
                    {{#if ../../../mk.canEditGroup}}<button type="button" class="mk-boat-assignment-remove" data-action="remove-boat-assignment" title="Unassign {{name}}" aria-label="Unassign {{name}}"><i class="fas fa-xmark"></i></button>{{/if}}
                  </div>
                  {{/each}}
                </div>
                {{else}}
                <p class="mk-boat-assignment-empty">No {{label}} assigned.</p>
                {{/if}}
              </section>
              {{/each}}
            </div>
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="mk-companions-empty">No boats yet. Drop an NPC boat into this tab to link it to the group.</p>
        {{/if}}
      </section>
    </div>

    <div class="tab mk-group-tab mk-group-tab-body" data-group="primary" data-tab="bastions" data-group-actor-kind="bastions">
      <section class="mk-group-linked-panel">
        <header class="mk-companions-header"><h2>Bastion</h2></header>
        <div class="mk-group-actor-dropzone">
          <i class="fas fa-chess-rook" aria-hidden="true"></i>
          <span>Drop a Bastion actor anywhere in this tab</span>
          <small>Click a bastion to open its Bastion Sheet.</small>
        </div>
        {{#if mk.bastions.hasEntries}}
        <div class="mk-group-actor-list">
          {{#each mk.bastions.entries}}
          <article class="mk-group-actor-card" data-group-actor-uuid="{{uuid}}">
            <button type="button" class="mk-group-actor-open" data-action="open-group-actor" data-actor-available="{{available}}" {{#unless available}}disabled{{/unless}}>
              <img src="{{img}}" alt="{{name}}">
              <strong>{{name}}</strong>
            </button>
            {{#if ../mk.canEditGroup}}<button type="button" class="mk-companion-remove" data-action="remove-group-actor" title="Remove {{name}} from group" aria-label="Remove {{name}} from group"><i class="fas fa-trash"></i></button>{{/if}}
          </article>
          {{/each}}
        </div>
        {{else}}
        <p class="mk-companions-empty">No bastions yet. Drop a Bastion actor into this tab to link it to the group.</p>
        {{/if}}
      </section>
    </div>
  </section>
</form>

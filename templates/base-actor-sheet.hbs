<form class="sdx-base-sheet-form {{cssClass}}" autocomplete="off">
  <header class="sdx-base-hero">
    <section class="sdx-base-portrait-card">
      <div class="sdx-base-type-ribbon">
        <img src="{{selectedBaseType.icon}}" alt="">
        <span>{{selectedBaseType.label}}</span>
      </div>
      <img class="sdx-base-image" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}">
      {{#if editable}}
      <button type="button" class="sdx-image-button" data-action="pick-image">
        <i class="fas fa-image"></i> Choose Image
      </button>
      {{/if}}
    </section>

    <section class="sdx-base-control-card">
      <div class="sdx-title-row">
        <img class="sdx-title-icon" src="{{icons.base}}" alt="">
        <input class="sdx-base-name" name="name" type="text" value="{{actor.name}}" placeholder="Base Name">
      </div>

      <div class="sdx-identity-grid grid grid-2col">
        <label class="sdx-field-card">
          <span>Type</span>
          <select name="system.base.type">
            {{#each baseTypes}}
            <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="sdx-field-card">
          <span>Location</span>
          <input name="system.base.location" type="text" value="{{system.base.location}}" placeholder="Wilderness, city, hex, region...">
        </label>
      </div>

      <div class="sdx-summary-grid">
        {{#each summaryNumbers}}
        <div class="sdx-summary-number">
          <div class="sdx-summary-icon-frame"><img src="{{icon}}" alt=""></div>
          <label>
            <span>{{label}}</span>
            <input name="{{name}}" type="number" value="{{value}}" min="{{min}}" max="{{max}}">
          </label>
          {{#if ../editable}}
          <div class="sdx-mini-stepper">
            <button type="button" data-action="adjust-number" data-path="{{path}}" data-delta="-1">-</button>
            <button type="button" data-action="adjust-number" data-path="{{path}}" data-delta="1">+</button>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>

      <div class="sdx-sheet-actions">
        <button type="button" class="sdx-icon-button" data-action="post-status">
          <img src="{{icons.status}}" alt=""> Post Status
        </button>
        <button type="button" class="sdx-icon-button" data-action="roll-event">
          <img src="{{icons.event}}" alt=""> Roll Event
        </button>
      </div>
    </section>
  </header>

  <main class="sdx-base-body">
    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.notes}}" alt=""><h2>Description</h2></div>
      </div>
      {{#if editable}}
      <textarea name="system.base.description" rows="5">{{system.base.description}}</textarea>
      {{else}}
      <div class="sdx-enriched-text">{{{descriptionHTML}}}</div>
      {{/if}}
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.supplies}}" alt=""><h2>Resources</h2></div>
      </div>
      <div class="sdx-resource-grid">
        {{#each resources}}
        <div class="sdx-resource-tile">
          <div class="sdx-resource-icon-frame"><img src="{{icon}}" alt=""></div>
          <label>
            <span>{{label}}</span>
            <input name="{{name}}" type="number" value="{{value}}" min="0">
          </label>
          {{#if ../editable}}
          <div class="sdx-mini-stepper">
            <button type="button" data-action="adjust-number" data-path="{{path}}" data-delta="-1">-</button>
            <button type="button" data-action="adjust-number" data-path="{{path}}" data-delta="1">+</button>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.facilities}}" alt=""><h2>Facilities</h2></div>
        {{#if editable}}<button type="button" class="sdx-icon-button compact" data-action="add-row" data-collection="facilities"><img src="{{icons.add}}" alt=""> Add</button>{{/if}}
      </div>
      <div class="sdx-row-list">
        {{#each facilities}}
        <article class="sdx-row-card">
          <label><span>Name</span><input name="system.facilities.{{index}}.name" type="text" value="{{name}}"></label>
          <label><span>Rank</span><input name="system.facilities.{{index}}.rank" type="number" value="{{rank}}" min="1" max="3"></label>
          <label><span>Condition</span><input name="system.facilities.{{index}}.condition" type="text" value="{{condition}}"></label>
          <label><span>Benefit</span><input name="system.facilities.{{index}}.benefit" type="text" value="{{benefit}}"></label>
          <label class="sdx-wide"><span>Note</span><textarea name="system.facilities.{{index}}.note" rows="2">{{note}}</textarea></label>
          {{#if ../editable}}<button type="button" class="sdx-icon-button compact" data-action="delete-row" data-collection="facilities" data-id="{{id}}"><img src="{{../icons.delete}}" alt=""> Delete</button>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.projects}}" alt=""><h2>Projects</h2></div>
        {{#if editable}}<button type="button" class="sdx-icon-button compact" data-action="add-row" data-collection="projects"><img src="{{icons.add}}" alt=""> Add</button>{{/if}}
      </div>
      <div class="sdx-row-list">
        {{#each projects}}
        <article class="sdx-row-card {{#if complete}}sdx-row-success{{/if}}">
          <label><span>Name</span><input name="system.projects.{{index}}.name" type="text" value="{{name}}"></label>
          <label><span>Progress</span><input name="system.projects.{{index}}.progress" type="number" value="{{progress}}" min="0"></label>
          <label><span>Target</span><input name="system.projects.{{index}}.target" type="number" value="{{target}}" min="1"></label>
          <label><span>Cost</span><input name="system.projects.{{index}}.cost" type="text" value="{{cost}}"></label>
          <label><span>Owner</span><input name="system.projects.{{index}}.owner" type="text" value="{{owner}}"></label>
          <label class="sdx-wide"><span>Note</span><textarea name="system.projects.{{index}}.note" rows="2">{{note}}</textarea></label>
          {{#if ../editable}}<button type="button" class="sdx-icon-button compact" data-action="delete-row" data-collection="projects" data-id="{{id}}"><img src="{{../icons.delete}}" alt=""> Delete</button>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.npcs}}" alt=""><h2>NPCs</h2></div>
        {{#if editable}}<button type="button" class="sdx-icon-button compact" data-action="add-row" data-collection="npcs"><img src="{{icons.add}}" alt=""> Add</button>{{/if}}
      </div>
      <div class="sdx-row-list">
        {{#each npcs}}
        <article class="sdx-row-card">
          <label><span>Name</span><input name="system.npcs.{{index}}.name" type="text" value="{{name}}"></label>
          <label><span>Role</span><input name="system.npcs.{{index}}.role" type="text" value="{{role}}"></label>
          <label><span>Loyalty</span><input name="system.npcs.{{index}}.loyalty" type="number" value="{{loyalty}}" min="0" max="6"></label>
          <label class="sdx-wide"><span>Note</span><textarea name="system.npcs.{{index}}.note" rows="2">{{note}}</textarea></label>
          {{#if ../editable}}<button type="button" class="sdx-icon-button compact" data-action="delete-row" data-collection="npcs" data-id="{{id}}"><img src="{{../icons.delete}}" alt=""> Delete</button>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.threats}}" alt=""><h2>Threats</h2></div>
        {{#if editable}}<button type="button" class="sdx-icon-button compact" data-action="add-row" data-collection="threats"><img src="{{icons.add}}" alt=""> Add</button>{{/if}}
      </div>
      <div class="sdx-row-list">
        {{#each threats}}
        <article class="sdx-row-card">
          <label><span>Name</span><input name="system.threats.{{index}}.name" type="text" value="{{name}}"></label>
          <label><span>Level</span><input name="system.threats.{{index}}.level" type="number" value="{{level}}" min="1" max="10"></label>
          <label><span>Clock</span><input name="system.threats.{{index}}.clock" type="number" value="{{clock}}" min="0" max="6"></label>
          <label class="sdx-wide"><span>Note</span><textarea name="system.threats.{{index}}.note" rows="2">{{note}}</textarea></label>
          {{#if ../editable}}<button type="button" class="sdx-icon-button compact" data-action="delete-row" data-collection="threats" data-id="{{id}}"><img src="{{../icons.delete}}" alt=""> Delete</button>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>

    <section class="sdx-base-card">
      <div class="sdx-section-header">
        <div><img src="{{icons.notes}}" alt=""><h2>Notes</h2></div>
      </div>
      {{#if editable}}
      <textarea name="system.notes" rows="6">{{system.notes}}</textarea>
      {{else}}
      <div class="sdx-enriched-text">{{{notesHTML}}}</div>
      {{/if}}
    </section>
  </main>
</form>

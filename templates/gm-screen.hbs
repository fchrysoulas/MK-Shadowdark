{{#if denied}}
<div class="mk-gm-screen-denied">
  <i class="fas fa-lock"></i>
  <strong>GM access required.</strong>
</div>
{{else}}
<div class="mk-gm-screen" data-workspace="{{workspace}}">
  <header class="mk-gm-screen-header">
    <div class="mk-gm-screen-title">
      <i class="fas fa-shield-halved"></i>
      <div>
        <strong>GM Screen</strong>
        <small>{{scene.name}}</small>
      </div>
    </div>

    <div class="mk-gm-group-selector" aria-label="Active Group">
      {{#if hasGroups}}
        {{#each groups}}
        <button type="button" data-action="selectGroup" data-group-uuid="{{uuid}}" class="{{#if selected}}is-active{{/if}}">
          <i class="fas fa-users"></i> {{name}}
        </button>
        {{/each}}
      {{else}}
        <span class="mk-gm-empty-inline">No MK-Shadowdark Group</span>
      {{/if}}
    </div>

    <div class="mk-gm-header-actions">
      <button type="button" data-action="refresh" title="Refresh GM Screen"><i class="fas fa-rotate"></i></button>
      <button type="button" data-action="openGroup" {{#unless hasGroups}}disabled{{/unless}}><i class="fas fa-users-gear"></i> Group Management</button>
    </div>
  </header>

  <section class="mk-gm-pressure-strip">
    <div><span>Procedure</span><strong>{{procedure}}</strong></div>
    <div><span>Elapsed</span><strong>{{elapsedLabel}}</strong></div>
    <div><span>Terrain</span><strong>{{environment.terrain}}</strong></div>
    <div><span>Danger</span><strong>{{environment.dangerLabel}}</strong></div>
    <div><span>Period</span><strong>{{environment.period}}</strong></div>
    <div><span>Encounter</span><strong>Every {{environment.intervalTurns}} turn{{#unless environment.intervalTurns}}s{{/unless}}</strong></div>
    {{#if combat.active}}
    <div class="is-combat"><span>Combat</span><strong>Round {{combat.round}}</strong></div>
    {{/if}}
  </section>

  <div class="mk-gm-screen-layout">
    <aside class="mk-gm-party-rail">
      <div class="mk-gm-rail-heading">
        <span>Active Party</span>
        <strong>{{party.length}}</strong>
      </div>

      <div class="mk-gm-party-list">
        {{#each party}}
        <article class="mk-gm-party-member is-{{severity}}">
          <button type="button" class="mk-gm-member-open" data-action="openMember" data-actor-uuid="{{actorUuid}}" title="Open {{name}}">
            <img src="{{img}}" alt="{{name}}">
          </button>
          <div class="mk-gm-member-body">
            <div class="mk-gm-member-name-row">
              <button type="button" data-action="openMember" data-actor-uuid="{{actorUuid}}">{{name}}</button>
              <button type="button" class="mk-gm-member-status" data-action="inspectMember" data-actor-uuid="{{actorUuid}}" title="Inspect GM status">
                <i class="fas fa-circle-info"></i>
              </button>
            </div>
            <div class="mk-gm-member-hp"><span style="--mk-gm-hp: {{hpPct}}%"></span></div>
            <div class="mk-gm-member-stats">
              <span>HP <strong>{{hp}}/{{hpMax}}</strong></span>
              <span>AC <strong>{{ac}}</strong></span>
            </div>
            <div class="mk-gm-member-flags">
              {{#if dead}}<span class="is-critical"><i class="fas fa-skull"></i> Dead</span>{{/if}}
              {{#if deathTimer.active}}<span class="is-critical"><i class="fas fa-hourglass-half"></i> {{deathTimer.turns}}</span>{{/if}}
              {{#if wounds.total}}<span><i class="fas fa-droplet"></i> {{wounds.total}}</span>{{/if}}
              {{#if focus.total}}<span><i class="fas fa-bullseye"></i> {{focus.total}}</span>{{/if}}
              {{#if light.total}}<span><i class="fas fa-fire-flame-simple"></i> {{light.total}}</span>{{/if}}
              {{#if effectCount}}<span><i class="fas fa-wand-magic-sparkles"></i> {{effectCount}}</span>{{/if}}
            </div>
          </div>
        </article>
        {{else}}
        <div class="mk-gm-empty">No active party members.</div>
        {{/each}}
      </div>
    </aside>

    <main class="mk-gm-workspace-shell">
      <nav class="mk-gm-workspace-nav" aria-label="GM Screen workspace">
        {{#each workspaces}}
        <button type="button" data-action="workspace" data-workspace="{{id}}" class="{{#if active}}is-active{{/if}}">{{label}}</button>
        {{/each}}
      </nav>

      <div class="mk-gm-workspace-body">
        <section class="mk-gm-workspace" data-workspace-panel="overview">
          <div class="mk-gm-panel-grid two-col">
            <article class="mk-gm-panel">
              <header><i class="fas fa-compass"></i><span>Procedure / Pressure</span></header>
              <dl class="mk-gm-data-list">
                <div><dt>Group</dt><dd>{{groupName}}</dd></div>
                <div><dt>Procedure</dt><dd>{{procedure}}</dd></div>
                <div><dt>Scene</dt><dd>{{scene.name}}</dd></div>
                <div><dt>Terrain</dt><dd>{{environment.terrain}}</dd></div>
                <div><dt>Danger</dt><dd>{{environment.dangerLabel}} · every {{environment.intervalTurns}} turns</dd></div>
                <div><dt>Period</dt><dd>{{environment.period}}</dd></div>
                <div><dt>Table</dt><dd>{{#if environment.tableConfigured}}Configured{{else}}Not configured{{/if}}</dd></div>
              </dl>
              <div class="mk-gm-panel-actions">
                <button type="button" data-action="configureEnvironment" {{#unless hasGroups}}disabled{{/unless}}><i class="fas fa-sliders"></i> Scene Context</button>
              </div>
            </article>

            <article class="mk-gm-panel">
              <header><i class="fas fa-dice-d20"></i><span>Encounter Pressure</span></header>
              {{#if exploration}}
              <div class="mk-gm-big-stats">
                <div><span>Exploration Turns</span><strong>{{exploration.completedTurns}}</strong></div>
                <div><span>Due Checks</span><strong>{{exploration.dueChecks}}</strong></div>
                <div><span>Next Check</span><strong>Turn {{exploration.intervalTurns}}</strong></div>
              </div>
              <div class="mk-gm-panel-actions">
                <button type="button" data-action="processDueEncounters" {{#unless exploration.canCheck}}disabled{{/unless}}><i class="fas fa-dice"></i> Check Due</button>
                {{#if latestEncounter}}<button type="button" data-action="stageLatestEncounter"><i class="fas fa-location-dot"></i> Stage Latest</button>{{/if}}
              </div>
              {{else}}
              <div class="mk-gm-empty">Select a Group to inspect encounter pressure.</div>
              {{/if}}
            </article>

            <article class="mk-gm-panel">
              <header><i class="fas fa-campground"></i><span>Resting</span></header>
              {{#if resting}}
              <div class="mk-gm-big-stats">
                <div><span>Status</span><strong>{{resting.status}}</strong></div>
                <div><span>Turns</span><strong>{{resting.completedTurns}}/{{resting.totalTurns}}</strong></div>
                <div><span>Checks Left</span><strong>{{resting.remainingChecks}}</strong></div>
              </div>
              {{#if resting.interrupted}}
              <div class="mk-gm-alert"><i class="fas fa-triangle-exclamation"></i> Rest interrupted. Resolve the encounter before resuming.</div>
              <div class="mk-gm-panel-actions"><button type="button" data-action="resumeRest"><i class="fas fa-play"></i> Resume Rest</button></div>
              {{/if}}
              {{else}}
              <div class="mk-gm-empty">No Group rest context.</div>
              {{/if}}
            </article>

            <article class="mk-gm-panel">
              <header><i class="fas fa-swords"></i><span>Combat / Morale</span></header>
              {{#if combat.active}}
              <div class="mk-gm-big-stats">
                <div><span>Round</span><strong>{{combat.round}}</strong></div>
                <div><span>Turn</span><strong>{{combat.turn}}</strong></div>
                <div><span>Current</span><strong>{{combat.currentCombatant.name}}</strong></div>
              </div>
              {{#if combat.morale}}
              <p class="mk-gm-secondary">Morale: {{combat.morale.livingCount}} / {{combat.morale.initialCount}} living · {{#if combat.morale.checked}}checked{{else}}pending{{/if}}</p>
              {{/if}}
              <div class="mk-gm-panel-actions"><button type="button" data-action="openCombat"><i class="fas fa-list-ol"></i> Combat Tracker</button></div>
              {{else}}
              <div class="mk-gm-empty">No active Combat.</div>
              {{/if}}
            </article>
          </div>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="exploration">
          <article class="mk-gm-panel is-wide">
            <header><i class="fas fa-map"></i><span>Exploration</span></header>
            {{#if exploration}}
            <div class="mk-gm-big-stats four-col">
              <div><span>Turns</span><strong>{{exploration.completedTurns}}</strong></div>
              <div><span>Turn Length</span><strong>{{exploration.turnMinutes}}m</strong></div>
              <div><span>Cadence</span><strong>{{exploration.intervalTurns}} turns</strong></div>
              <div><span>Due</span><strong>{{exploration.dueChecks}}</strong></div>
            </div>
            <dl class="mk-gm-data-list">
              <div><dt>Terrain</dt><dd>{{exploration.terrain}}</dd></div>
              <div><dt>Period</dt><dd>{{exploration.period}}</dd></div>
              <div><dt>Danger</dt><dd>{{exploration.dangerLabel}}</dd></div>
              <div><dt>Encounter Table</dt><dd>{{exploration.tableName}}</dd></div>
              {{#if exploration.latest}}<div><dt>Latest Check</dt><dd>{{exploration.latest.label}}</dd></div>{{/if}}
            </dl>
            <div class="mk-gm-panel-actions">
              <button type="button" data-action="configureEnvironment"><i class="fas fa-sliders"></i> Scene Context</button>
              <button type="button" data-action="processDueEncounters" {{#unless exploration.canCheck}}disabled{{/unless}}><i class="fas fa-dice"></i> Process Due Checks</button>
              <button type="button" data-action="openGroup"><i class="fas fa-route"></i> Group Traveling</button>
            </div>
            {{else}}
            <div class="mk-gm-empty">No Group selected.</div>
            {{/if}}
          </article>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="resting">
          <article class="mk-gm-panel is-wide">
            <header><i class="fas fa-campground"></i><span>Resting / Camp</span></header>
            {{#if resting}}
            <div class="mk-gm-big-stats four-col">
              <div><span>Status</span><strong>{{resting.status}}</strong></div>
              <div><span>Mode</span><strong>{{resting.mode}}</strong></div>
              <div><span>Turns</span><strong>{{resting.completedTurns}}/{{resting.totalTurns}}</strong></div>
              <div><span>Checks Left</span><strong>{{resting.remainingChecks}}</strong></div>
            </div>
            {{#if resting.nextCheckTurn}}<p class="mk-gm-secondary">Next required encounter check: resting turn {{resting.nextCheckTurn}}.</p>{{/if}}
            {{#if resting.interrupted}}<div class="mk-gm-alert"><i class="fas fa-triangle-exclamation"></i> Rest is interrupted and benefits/rations remain pending.</div>{{/if}}
            <div class="mk-gm-panel-actions">
              {{#if resting.interrupted}}<button type="button" data-action="resumeRest"><i class="fas fa-play"></i> Resume Rest</button>{{/if}}
              {{#if latestEncounter}}<button type="button" data-action="stageLatestEncounter"><i class="fas fa-location-dot"></i> Stage Latest Encounter</button>{{/if}}
              <button type="button" data-action="openGroup"><i class="fas fa-bed"></i> Group Camping</button>
            </div>
            {{else}}
            <div class="mk-gm-empty">No Group selected.</div>
            {{/if}}
          </article>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="encounter">
          <article class="mk-gm-panel is-wide">
            <header><i class="fas fa-skull-crossbones"></i><span>Latest Group Encounter</span></header>
            {{#if latestEncounter}}
            <div class="mk-gm-encounter-head">
              <strong>{{latestEncounter.count}} × {{latestEncounter.label}}</strong>
              <span class="is-{{latestEncounter.disposition}}">{{latestEncounter.disposition}}</span>
            </div>
            <dl class="mk-gm-data-list">
              <div><dt>Terrain</dt><dd>{{latestEncounter.terrain}}</dd></div>
              <div><dt>Danger</dt><dd>{{latestEncounter.danger}}</dd></div>
              <div><dt>Period</dt><dd>{{latestEncounter.period}}</dd></div>
              <div><dt>Distance</dt><dd>{{latestEncounter.distance}}</dd></div>
              <div><dt>Activity</dt><dd>{{latestEncounter.activity}}</dd></div>
              <div><dt>Reaction</dt><dd>{{latestEncounter.reaction}}</dd></div>
              <div><dt>Staging</dt><dd>{{#if latestEncounter.staged}}Already staged{{else}}Not staged{{/if}}</dd></div>
            </dl>
            <div class="mk-gm-panel-actions">
              <button type="button" data-action="stageLatestEncounter"><i class="fas fa-location-dot"></i> {{#if latestEncounter.staged}}Stage Again{{else}}Stage Encounter{{/if}}</button>
            </div>
            {{else}}
            <div class="mk-gm-empty">No resolved encounter card exists for this Group yet.</div>
            {{/if}}
          </article>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="combat">
          <article class="mk-gm-panel is-wide">
            <header><i class="fas fa-swords"></i><span>Combat / Morale</span></header>
            {{#if combat.active}}
            <div class="mk-gm-big-stats four-col">
              <div><span>Round</span><strong>{{combat.round}}</strong></div>
              <div><span>Turn</span><strong>{{combat.turn}}</strong></div>
              <div><span>Current</span><strong>{{combat.currentCombatant.name}}</strong></div>
              {{#if combat.morale}}<div><span>Enemy Force</span><strong>{{combat.morale.livingCount}}/{{combat.morale.initialCount}}</strong></div>{{/if}}
            </div>
            <div class="mk-gm-combat-list">
              {{#each combat.combatants}}
              <div class="{{#if current}}is-current{{/if}} {{#if defeated}}is-defeated{{/if}}">
                <img src="{{img}}" alt="{{name}}"><span>{{name}}</span><strong>{{initiative}}</strong>
              </div>
              {{/each}}
            </div>
            {{#if combat.morale}}
            <div class="mk-gm-morale-summary">
              <span>Morale threshold: <strong>{{combat.morale.threshold}}</strong></span>
              <span>Status: <strong>{{#if combat.morale.checked}}Resolved{{else}}Watching{{/if}}</strong></span>
            </div>
            {{/if}}
            <div class="mk-gm-panel-actions"><button type="button" data-action="openCombat"><i class="fas fa-list-ol"></i> Open Combat Tracker</button></div>
            {{else}}
            <div class="mk-gm-empty">No active Foundry Combat.</div>
            {{/if}}
          </article>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="environment">
          <article class="mk-gm-panel is-wide">
            <header><i class="fas fa-mountain-sun"></i><span>Scene / Environment</span></header>
            <dl class="mk-gm-data-list">
              <div><dt>Scene</dt><dd>{{scene.name}}</dd></div>
              <div><dt>Terrain</dt><dd>{{environment.terrain}}</dd></div>
              <div><dt>Danger</dt><dd>{{environment.dangerLabel}}</dd></div>
              <div><dt>Period</dt><dd>{{environment.period}}</dd></div>
              <div><dt>Encounter Cadence</dt><dd>Every {{environment.intervalTurns}} procedure turns</dd></div>
              <div><dt>Encounter Table</dt><dd>{{#if environment.tableConfigured}}Configured{{else}}Not configured{{/if}}</dd></div>
            </dl>
            <div class="mk-gm-panel-actions"><button type="button" data-action="configureEnvironment" {{#unless hasGroups}}disabled{{/unless}}><i class="fas fa-sliders"></i> Edit Scene Encounter Context</button></div>
          </article>
        </section>

        <section class="mk-gm-workspace" data-workspace-panel="rules">
          <div class="mk-gm-panel-grid two-col">
            <article class="mk-gm-panel">
              <header><i class="fas fa-clock"></i><span>Procedure Turns</span></header>
              <ul class="mk-gm-rules-list">
                <li><strong>Encounter intervals are turns.</strong></li>
                <li>Exploration turn: <strong>6 minutes</strong> by default.</li>
                <li>Resting turn: <strong>1 hour</strong>.</li>
                <li>Unsafe: check every <strong>3 turns</strong>.</li>
                <li>Risky: check every <strong>2 turns</strong>.</li>
                <li>Deadly: check <strong>every turn</strong>.</li>
              </ul>
            </article>
            <article class="mk-gm-panel">
              <header><i class="fas fa-dice-d20"></i><span>Encounter Procedure</span></header>
              <ul class="mk-gm-rules-list">
                <li>Default occurrence: <strong>1d6; encounter on 1</strong>.</li>
                <li>Distance: 1 Close, 2–4 Near, 5–6 Far.</li>
                <li>Activity: Shadowdark 2d6 activity table.</li>
                <li>Reaction: 2d6, modified when the procedure requests CHA.</li>
                <li>Staging is preview-first; nothing is created until Deploy.</li>
              </ul>
            </article>
            <article class="mk-gm-panel">
              <header><i class="fas fa-flag"></i><span>Morale</span></header>
              <ul class="mk-gm-rules-list">
                <li>Morale check: <strong>DC 15 WIS</strong>.</li>
                <li>Groups check at half starting force.</li>
                <li>Solo enemies check at half HP.</li>
                <li>A living assigned leader checks for the force.</li>
                <li>Failures receive <strong>Fleeing</strong>; immune creatures are excluded.</li>
              </ul>
            </article>
            <article class="mk-gm-panel">
              <header><i class="fas fa-bed"></i><span>Resting</span></header>
              <ul class="mk-gm-rules-list">
                <li>Normal Group rest: <strong>8 one-hour turns</strong>.</li>
                <li>Encounter checks resolve before rest benefits.</li>
                <li>An encounter pauses the rest.</li>
                <li>Rations and benefits finalize only after successful completion.</li>
              </ul>
            </article>
          </div>
        </section>
      </div>
    </main>
  </div>
</div>
{{/if}}

<form class="sdx-group-sheet {{cssClass}}" autocomplete="off" style="{{sdx.sheetStyle}}">
  <header class="sdx-group-header">
    <img class="sdx-group-image" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}">

    <div class="sdx-group-title-block">
      <input class="sdx-group-name" name="name" type="text" value="{{actor.name}}" placeholder="Group Name">

      <div class="sdx-group-stats">
        <span><i class="fas fa-users"></i> Members <strong>{{sdx.summary.count}}</strong></span>
        <span><i class="fas fa-heart"></i> HP <strong>{{sdx.summary.hp.value}}/{{sdx.summary.hp.max}}</strong></span>
        <span><i class="fas fa-shield-alt"></i> Avg AC <strong>{{sdx.summary.ac}}</strong></span>
        <span><i class="fas fa-arrow-up"></i> Avg LVL <strong>{{sdx.summary.level}}</strong></span>
      </div>
    </div>
  </header>

  <nav class="sdx-group-nav tabs" data-group="primary">
    <a class="item active" data-tab="members"><i class="fas fa-users"></i> Members</a>
    <a class="item" data-tab="traveling"><i class="fas fa-route"></i> Traveling</a>
    <a class="item" data-tab="camping"><i class="fas fa-campground"></i> Camping</a>
    <a class="item" data-tab="inventory"><i class="fas fa-box-open"></i> Inventory</a>
    <a class="item" data-tab="notes"><i class="fas fa-scroll"></i> Notes</a>
  </nav>

  <section class="sdx-group-content">
    <div class="tab sdx-group-tab sdx-group-tab-body active" data-group="primary" data-tab="members">
      {{#if sdx.canEditGroup}}
      <div class="sdx-group-dropzone">
        <i class="fas fa-hand-pointer"></i>
        Drop actors here, or use the sheet header button to add controlled tokens.
      </div>
      {{/if}}

      {{#if sdx.hasMembers}}
      <div class="sdx-group-members">
        {{#each sdx.members}}
        <article class="sdx-group-member" data-member-uuid="{{uuid}}">
          {{#if ../sdx.canEditGroup}}
          <button type="button" class="sdx-member-remove" data-action="remove-member" title="Remove member"><i class="fas fa-times"></i></button>
          {{/if}}

          <img class="sdx-member-image" src="{{img}}" alt="{{name}}" data-action="open-member">

          <div class="sdx-member-main">
            <div class="sdx-member-name-row">
              <button type="button" class="sdx-member-name" data-action="open-member">{{name}}</button>
              <span class="sdx-member-class">{{className}}</span>
            </div>

            <div class="sdx-member-hp-row">
              <span class="sdx-small-label">HP</span>
              <span class="sdx-hp-text">{{hp.value}}/{{hp.max}}</span>
              <div class="sdx-hp-bar"><div class="sdx-hp-fill" style="width: {{hp.pct}}%;"></div></div>
            </div>

            <div class="sdx-member-abilities">
              {{#each abilities}}
              <button type="button" class="sdx-ability-button" data-action="roll-ability" data-ability="{{key}}" title="Roll {{label}}">
                <span>{{label}}</span>
                <strong>{{mod}}</strong>
              </button>
              {{/each}}
            </div>
          </div>

          <div class="sdx-member-side-stats">
            <span class="sdx-side-stat">AC <strong>{{ac}}</strong></span>
            <span class="sdx-side-stat">LVL <strong>{{level}}</strong></span>
            <span class="sdx-side-stat sdx-xp-stat">
              XP <strong>{{xp.value}}/{{xp.next}}</strong>
              {{#if ../sdx.canEditGroup}}
              <button type="button" data-action="xp-decrement" title="Decrease XP"><i class="fas fa-minus"></i></button>
              <button type="button" data-action="xp-increment" title="Increase XP"><i class="fas fa-plus"></i></button>
              {{/if}}
            </span>
            <span class="sdx-side-stat {{#if slots.over}}sdx-danger{{/if}}">Slots <strong>{{slots.total}}/{{slots.max}}</strong></span>
          </div>
        </article>
        {{/each}}
      </div>
      {{else}}
      <div class="sdx-empty-group">{{#if sdx.canEditGroup}}No members yet. Drop player actors or tokens onto this sheet.{{else}}No members yet. Ask the GM to add party members.{{/if}}</div>
      {{/if}}
    </div>

    <div class="tab sdx-group-tab sdx-group-tab-body" data-group="primary" data-tab="traveling">
      <div class="sdx-travel-toolbar">
        <button type="button" data-action="cycle-weather"><i class="fas fa-cloud-sun-rain"></i> Weather: {{sdx.travel.weatherLabel}}</button>

        <label class="sdx-speed-control">Speed
          <select data-action="change-speed">
            {{#each sdx.travel.speedOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      </div>
    </div>

    <div class="tab sdx-group-tab sdx-group-tab-body" data-group="primary" data-tab="camping">
      <section class="sdx-camping-info">
        <div class="sdx-camping-procedure">
          <ol>
            <strong>PROCEDURE</strong>
            <li>The PCs make task checks in any order they choose.</li>
            <li>After resolving tasks, the GM follows normal resting and random encounter procedures.</li>
          </ol>
        </div>

        <div class="sdx-campfire-note">
          <strong>Campfire</strong>
          <p>The PCs can make a campfire using 3 torches; it lasts 8 hours while a PC remains near to it and casts light out to a near distance.</p>
          <div class="sdx-campfire-resources">
            <span title="Total food and rations carried by members plus shared group inventory">
              <i class="fas fa-utensils"></i>
              <strong>{{sdx.campingResources.food.total}}</strong>
            </span>
            <span title="Total torches carried by members plus shared group inventory">
              <i class="fas fa-fire"></i>
              <strong>{{sdx.campingResources.torches.total}}</strong>
            </span>
            <span title="Total water carried by members plus shared group inventory">
              <i class="fas fa-tint"></i>
              <strong>{{sdx.campingResources.water.total}}</strong>
            </span>
          </div>
        </div>
      </section>

      {{#if sdx.travel.hasMembers}}
      <div class="sdx-camping-roster">
        {{#each sdx.travel.members}}
        <button
          type="button"
          class="sdx-camping-roster-member {{#if assigned}}is-assigned{{/if}} {{#unless canAssign}}is-unavailable{{/unless}}"
          data-action="open-member"
          data-camping-member-drag="true"
          data-member-uuid="{{uuid}}"
          data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
          draggable="{{#if canAssign}}true{{else}}false{{/if}}"
          title="{{#unless canAssign}}{{name}} is controlled by another user{{else}}{{#if assignedActivityName}}{{name}}: {{assignedActivityName}}{{else}}{{name}} is unassigned{{/if}}{{/unless}}"
        >
          <span class="sdx-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
          <span>{{name}}</span>
          {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{else}}<small>Free</small>{{/if}}
        </button>
        {{/each}}
        {{#if sdx.canEditGroup}}
        <button type="button" class="sdx-camping-reset" data-action="reset-travel" data-tooltip="Reset Assignments" aria-label="Reset Assignments">
          <i class="fas fa-undo"></i>
        </button>
        {{/if}}
      </div>
      {{else}}
      <div class="sdx-camping-roster-empty">Add members to the group to assign camping tasks.</div>
      {{/if}}

      <div class="sdx-travel-grid">
        {{#each sdx.travel.activities}}
        <article class="sdx-travel-card" data-travel-activity-key="{{key}}">
          <header class="sdx-travel-card-header">
            <span class="sdx-travel-activity-icon" aria-hidden="true">
              <img src="{{icon}}" alt="">
            </span>

            <div class="sdx-travel-title" data-tooltip="{{description}}" aria-label="{{description}}" tabindex="0">
              <strong class="sdx-travel-name">{{name}}</strong>
              <span class="sdx-travel-meta">{{abilityLabel}} <b>DC {{dc}}</b></span>
            </div>

            <button type="button" class="sdx-travel-roll" data-action="roll-travel-activity" data-has-assigned="{{#if hasAssigned}}true{{else}}false{{/if}}" title="{{#if hasAssigned}}Roll {{name}}{{else}}Assign a character to roll {{name}}{{/if}}" {{#unless hasAssigned}}disabled{{/unless}}>
              <i class="fas fa-dice-d20"></i>
            </button>
          </header>

          <div class="sdx-camping-assignment-row" data-action="toggle-travel-picker" title="Choose assigned members">
            <div class="sdx-camping-assignment-summary" title="{{assignmentLabel}}">
              {{#if hasAssigned}}
              {{#each assigned}}
              <button type="button" class="sdx-camping-assigned-chip" data-action="open-member" data-assigned-actor-uuid="{{uuid}}" title="{{name}}">
                <span class="sdx-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
              </button>
              {{/each}}
              {{else}}
              <span class="sdx-camping-unassigned">Unassigned</span>
              {{/if}}
            </div>
          </div>

          {{#if hasMemberOptions}}
          <div class="sdx-camping-picker-panel">
            <div class="sdx-travel-member-picker">
              {{#each memberOptions}}
              <button
                type="button"
                class="sdx-travel-member-toggle {{#if assigned}}is-assigned{{/if}} {{#if assignedElsewhere}}is-assigned-elsewhere{{/if}}"
                data-action="toggle-travel-participant"
                data-member-uuid="{{uuid}}"
                data-can-assign="{{#if canAssign}}true{{else}}false{{/if}}"
                title="{{title}}"
                {{#unless canAssign}}disabled{{/unless}}
              >
                <span class="sdx-camping-portrait"><img src="{{img}}" alt="{{name}}"></span>
                <span>{{name}}</span>
                {{#if assignedActivityName}}<small>{{assignedActivityName}}</small>{{/if}}
              </button>
              {{/each}}
            </div>
          </div>
          {{/if}}
        </article>
        {{/each}}
      </div>
    </div>

    <div class="tab sdx-group-tab sdx-group-tab-body" data-group="primary" data-tab="inventory">
      <div class="sdx-inventory-layout">
        <section class="sdx-shared-items-panel">
          <header class="sdx-inventory-panel-header">
            <button type="button" class="sdx-panel-add-button" data-action="create-group-item" title="Add gear"><i class="fas fa-plus"></i></button>
            <h2>Shared Items</h2>
            <span class="sdx-inventory-slots {{#if sdx.inventory.slots.over}}sdx-danger{{/if}}"><i class="fas fa-weight-hanging"></i> <strong>{{sdx.inventory.slots.total}}/{{sdx.inventory.slots.max}}</strong></span>
          </header>

          <div class="sdx-shared-items-table">
            <div class="sdx-shared-items-table-header">
              <span>Item</span>
              <span>Qty</span>
              <span>Slots</span>
            </div>

            <div class="sdx-shared-items-table-body">
              {{#if sdx.inventory.hasItems}}
              {{#each sdx.inventory.items}}
              <div class="sdx-shared-item-row" data-item-id="{{id}}">
                <div class="sdx-shared-item-name-cell">
                  <img src="{{img}}" alt="{{name}}" data-action="open-item">
                  <button type="button" class="sdx-inventory-name" data-action="open-item">{{name}}</button>
                </div>

                <div class="sdx-shared-item-qty-cell">
                  <button type="button" data-action="item-decrement" title="Decrease quantity"><i class="fas fa-minus"></i></button>
                  <strong>{{quantity}}</strong>
                  <button type="button" data-action="item-increment" title="Increase quantity"><i class="fas fa-plus"></i></button>
                </div>

                <div class="sdx-shared-item-slots-cell">{{slots}}</div>
              </div>
              {{/each}}
              {{else}}
              <div class="sdx-shared-items-empty">No shared items. Drop gear here or press +.</div>
              {{/if}}
            </div>
          </div>
        </section>

        <aside class="sdx-party-treasure-panel">
          <h2>Party Treasure</h2>

          <label class="sdx-coin-row"><span>GP</span><input type="number" value="{{sdx.inventory.coins.gp}}" min="0" data-action="change-group-coin" data-coin="gp"></label>
          <label class="sdx-coin-row"><span>SP</span><input type="number" value="{{sdx.inventory.coins.sp}}" min="0" data-action="change-group-coin" data-coin="sp"></label>
          <label class="sdx-coin-row"><span>CP</span><input type="number" value="{{sdx.inventory.coins.cp}}" min="0" data-action="change-group-coin" data-coin="cp"></label>

          <p class="sdx-coin-slots"><i class="fas fa-weight-hanging"></i> Coin slots <strong>{{sdx.inventory.coinSlots}}</strong></p>

          <button type="button" class="sdx-divide-coins-button" data-action="divide-coins"><i class="fas fa-coins"></i> Divide Coins</button>
        </aside>
      </div>
    </div>

    <div class="tab sdx-group-tab sdx-group-tab-body" data-group="primary" data-tab="notes">
      <div class="sdx-group-notes">
        <textarea class="sdx-group-notes-text" name="system.notes" rows="18" placeholder="Group notes, travel log, debts, rumors, shared goals...">{{actor.system.notes}}</textarea>
      </div>
    </div>
  </section>
</form>

{{#if denied}}
<div class="mk-gm-settings-denied">
  <i class="fas fa-lock" aria-hidden="true"></i>
  <strong>GM access required.</strong>
</div>
{{else}}
<div class="mk-gm-settings" data-mk-gm-settings data-settings-tab="{{activeTab}}">
  <aside class="mk-gm-settings-sidebar">
    <div class="mk-gm-settings-sidebar-heading">
      <i class="fas fa-shield-halved" aria-hidden="true"></i>
      <strong>GM Screen</strong>
    </div>

    <div class="mk-gm-settings-search" aria-hidden="true">
      <i class="fas fa-search" aria-hidden="true"></i>
      <span>Settings</span>
    </div>

    <nav class="mk-gm-settings-nav" aria-label="GM Screen Settings" role="tablist">
      <div class="mk-gm-settings-nav-group">
        <h2>GM Screen</h2>
        {{#each tabs}}
        <button
          type="button"
          class="{{#if active}}is-active{{/if}}"
          data-action="settingsTab"
          data-settings-tab="{{id}}"
          role="tab"
          aria-selected="{{active}}"
          title="{{label}}"
        >
          <i class="fas {{icon}}" aria-hidden="true"></i>
          <span>{{label}}</span>
        </button>
        {{/each}}
      </div>
    </nav>

    <div class="mk-gm-settings-sidebar-footer">MK-Shadowdark</div>
  </aside>

  <main class="mk-gm-settings-content">
    {{#if (eq activeTab "home")}}
    <section class="mk-gm-settings-page" data-settings-page="home" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen Settings</span>
          <h1>Welcome to the GM Screen</h1>
        </div>
        <i class="fas fa-sliders" aria-hidden="true"></i>
      </header>

      <article class="mk-gm-settings-card">
        <h2>Configure your GM tools</h2>
        <p>Use the settings tabs on the left to configure Scene-owned generators and RollTable assignments.</p>
        <p>Use each feature card's checkbox to choose which Quick Actions appear on the main GM Screen.</p>
      </article>

      <article class="mk-gm-settings-card mk-gm-settings-transfer" data-mk-gm-screen-transfer>
        <div>
          <h2>Scene Configuration</h2>
          <p>Export or import this Scene's GM Screen configuration, including encounter zones, generators, environment context, and RollTable assignments.</p>
        </div>
        <div class="mk-gm-settings-transfer-actions" data-mk-gm-screen-transfer-actions></div>
      </article>

      {{#each homeFeatures}}
      <article class="mk-gm-settings-card mk-gm-settings-card-accent" data-mk-gm-home-feature="{{id}}">
        <div>
          <h2>{{homeTitle}}</h2>
          <p>{{homeDescription}}</p>
        </div>
        <div class="mk-gm-settings-quick-action-control">
          <label class="mk-gm-settings-quick-action-toggle" title="Show or hide {{label}} in Quick Actions">
            <input
              type="checkbox"
              data-mk-gm-quick-action-toggle="{{overviewTool}}"
              {{#if quickActionEnabled}}checked{{/if}}
            >
            <span>
              <strong>Show in Quick Actions</strong>
              <small>{{#if quickActionEnabled}}Visible on the GM Screen{{else}}Hidden from the GM Screen{{/if}}</small>
            </span>
          </label>
        </div>
      </article>
      {{/each}}
    </section>
    {{/if}}

    {{#if (eq activeTab "tavern-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="tavern-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Tavern Generator</h1>
          <p>Scene-owned RollTables used to generate tavern names, Wealth, Known For results, and tiered Poor, Standard, and Wealthy food and drink lists.</p>
        </div>
        <i class="fas fa-beer-mug-empty" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-tavern-generator" data-mk-gm-tavern-generator>
        <div data-mk-tavern-generator-tables>
          <div class="mk-gm-empty">Loading Tavern Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "shop-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="shop-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Shop Generator</h1>
      <p>Scene-owned RollTables used to roll shop quality, generate names, Known For results, and Interesting Customers.</p>
        </div>
        <i class="fas fa-store" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-shop-generator" data-mk-shop-generator>
        <div data-mk-shop-generator-tables>
          <div class="mk-gm-empty">Loading Shop Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "location-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="location-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Location Generator</h1>
          <p>Scene-owned RollTables used to generate location Descriptors, Locations, and Features.</p>
        </div>
        <i class="fas fa-map-location-dot" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-location-generator" data-mk-location-generator>
        <div data-mk-location-generator-tables>
          <div class="mk-gm-empty">Loading Location Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "encounters")}}
    <section class="mk-gm-settings-page" data-settings-page="encounters" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Encounters</h1>
          <p>Configure Encounter Zones and the three supporting RollTables used by Roll Encounter. Trap and Hazard generators are independent.</p>
        </div>
        <i class="fas fa-dice-d20" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-encounters" data-mk-gm-encounters>
        <div data-mk-exploration-zone-grid>
          <div class="mk-gm-empty">Loading Encounter Zones…</div>
        </div>
        <div data-mk-encounter-auxiliary-tables>
          <div class="mk-gm-empty">Loading encounter RollTables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "trap-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="trap-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Trap Generator</h1>
          <p>Assign three Scene-owned RollTables for generating trap results independently from normal encounters.</p>
        </div>
        <i class="fas fa-spider" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-generator" data-mk-gm-generator="trap">
        <div data-mk-encounter-generator-target="trap">
          <div class="mk-gm-empty">Loading Trap Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "hazard-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="hazard-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Hazard Generator</h1>
          <p>Assign three Scene-owned RollTables for generating hazard results independently from normal encounters.</p>
        </div>
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-generator" data-mk-gm-generator="hazard">
        <div data-mk-encounter-generator-target="hazard">
          <div class="mk-gm-empty">Loading Hazard Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "compositions")}}
    <section class="mk-gm-settings-page" data-settings-page="compositions" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>NPC Generator</h1>
          <p>Scene-owned RollTables used to compose generated NPC names and traits.</p>
        </div>
        <i class="fas fa-font" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-compositions" data-mk-gm-compositions>
        <div data-mk-npc-name-composition>
          <div class="mk-gm-empty">Loading name composition tables…</div>
        </div>
        <div data-mk-npc-trait-tables>
          <div class="mk-gm-empty">Loading NPC trait tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "monster-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="monster-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Monster Generator</h1>
          <p>Scene-owned RollTables used to generate combat traits, quality, strengths, weaknesses, and mutations.</p>
        </div>
        <i class="fas fa-skull-crossbones" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-generator mk-gm-settings-monster-generator" data-mk-gm-monster-generator>
        <div data-mk-monster-generator-tables>
          <div class="mk-gm-empty">Loading Monster Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}

    {{#if (eq activeTab "magic-item-generator")}}
    <section class="mk-gm-settings-page" data-settings-page="magic-item-generator" role="tabpanel">
      <header class="mk-gm-settings-page-heading">
        <div>
          <span class="mk-gm-settings-eyebrow">GM Screen / Settings</span>
          <h1>Magic Item Generator</h1>
          <p>Scene-owned RollTables used to generate magic item names, bonuses, benefits, curses, and personalities.</p>
        </div>
        <i class="fas fa-wand-sparkles" aria-hidden="true"></i>
      </header>

      <section class="mk-gm-settings-card mk-gm-settings-generator mk-gm-settings-magic-item-generator" data-mk-gm-magic-item-generator>
        <div data-mk-magic-item-generator-tables>
          <div class="mk-gm-empty">Loading Magic Item Generator tables…</div>
        </div>
      </section>
    </section>
    {{/if}}
  </main>
</div>
{{/if}}

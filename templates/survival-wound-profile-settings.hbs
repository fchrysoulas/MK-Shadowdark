<form class="mk-feature-settings-form" autocomplete="off">
  <p class="mk-settings-note">Choose what happens after a failed DC 12 CON check when a player survives the dying state.</p>

  <div class="mk-settings-grid">
    <section class="mk-settings-section">
      <div class="mk-setting-row">
        <div class="mk-setting-copy">
          <label for="mk-setting-detailedWoundsSurvivalProfile">Profile</label>
          <p class="notes">MK Detailed Wounds uses the module's v3 injury system. Enduring Wounds draws from a GM-supplied RollTable without interpreting or copying its results.</p>
        </div>
        <div class="mk-setting-control">
          <select id="mk-setting-detailedWoundsSurvivalProfile" name="detailedWoundsSurvivalProfile" data-dtype="String">
            {{#each profiles}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="mk-setting-row" data-enduring-wounds-table-row {{#unless showTableUuid}}style="display:none"{{/unless}}>
        <div class="mk-setting-copy">
          <label for="mk-setting-enduringWoundsTableUuid">Enduring Wounds RollTable UUID</label>
          <p class="notes">Paste the UUID of a world or compendium RollTable you own and configured. Missing or invalid tables fail safely and do not alter the character.</p>
        </div>
        <div class="mk-setting-control">
          <input id="mk-setting-enduringWoundsTableUuid" type="text" name="enduringWoundsTableUuid" value="{{tableUuid}}" data-dtype="String">
        </div>
      </div>
    </section>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fas fa-floppy-disk"></i> Save Settings
    </button>
  </footer>
</form>
